{
  "name": "celenas-smp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/next.mjs dev --hostname 127.0.0.1",
    "build": "node scripts/next.mjs build",
    "prepare:pages": "node scripts/prepare-pages-redirect.mjs",
    "verify:pages": "node scripts/verify-pages-export.mjs",
    "verify:pages-redirect": "node scripts/verify-pages-redirect.mjs",
    "verify:cloudflare": "node scripts/verify-cloudflare-export.mjs",
    "start": "node scripts/next.mjs start --hostname 127.0.0.1",
    "gallery:add": "node scripts/gallery-add.mjs",
    "gallery:list": "node scripts/gallery-list.mjs",
    "gallery:remove": "node scripts/gallery-remove.mjs",
    "gallery:validate": "node scripts/gallery-validate.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node scripts/next.mjs typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm gallery:validate && pnpm test && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "sharp": "^0.35.5",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
